{
  "name": "@kybernetes/server",
  "version": "0.3.0",
  "private": true,
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/boot.mjs --external:ws --sourcemap --log-level=warning",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/boot.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@kybernetes/protocol": "workspace:*",
    "@kybernetes/sim-core": "workspace:*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@kybernetes/tsconfig": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
