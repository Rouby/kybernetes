{
  "name": "@kybernetes/web",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep \"@smoke\"",
    "test:e2e:nightly": "playwright test --grep \"@slow\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@kybernetes/protocol": "workspace:*",
    "@kybernetes/sim-core": "workspace:*",
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@kybernetes/tsconfig": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/matter-js": "^0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
